# Settings for test/Caddyfile. Copy to .env and fill in.
#
# Caddy envfile format: KEY=value with no space after "=". "#" starts a
# comment anywhere on the line, even inside quotes, so values cannot contain
# it. One pair of surrounding quotes is stripped.

## Site ########################################################################

# HTTPS origin Caddy serves. localhost gets a cert from Caddy's local CA,
# which isn't added to the system trust store, so expect a browser warning.
# Register this redirect URI with the IdP:
#   <SITE_ORIGIN>/_authcrunch/oauth2/ldapauthz/authorization-code-callback
SITE_ORIGIN=https://localhost:8443

# DEBUG logs each ldap_authz decision (identity, search filter, DN found,
# groups) and caddy-security's login flow. Default: INFO
#LOG_LEVEL=DEBUG

## OIDC (caddy-security) #######################################################

# Issuer URL; /.well-known/openid-configuration is appended.
OIDC_PROVIDER_URL=https://dex.example.com
OIDC_CLIENT_ID=caddy-ldapauthz
OIDC_CLIENT_SECRET=change-me
# Default: openid profile email (add "groups" for Dex)
#OIDC_SCOPES=openid profile email groups
# Session lifetime in seconds. Default: 3600
#OIDC_SESSION_LIFETIME=3600

## LDAP (ldap_authz) ###########################################################

# ldaps://host:636, or ldap://host:389 with LDAP_STARTTLS=on
LDAP_URL=ldaps://dc.corp.example.com:636
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAP_BIND_DN=CN=svc-caddy,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=change-me

# Full group DNs allowed access, separated by spaces. Wrap a DN that contains
# spaces in double quotes and the whole value in single quotes:
#   LDAP_ALLOW='"CN=App Users,OU=Groups,DC=corp,DC=example,DC=com" CN=App-Admins,OU=Groups,DC=corp,DC=example,DC=com'
# Empty lets in ANY user found in the directory.
LDAP_ALLOW=CN=App-Users,OU=Groups,DC=corp,DC=example,DC=com

# Optional; defaults shown.
# Placeholder holding the identity to look up. Use {http.auth.user.username}
# for the IdP's preferred_username.
#LDAP_USER={http.auth.user.email}
# Must contain {user}. Default matches userPrincipalName on enabled accounts.
# Example matching sAMAccountName instead (pair with LDAP_STRIP_DOMAIN=on):
#LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={user}))
# PEM CA bundle for the DC certificate. Default: system pool.
#LDAP_CA_FILE=/path/to/ca.pem
# Flags: on/off
#LDAP_STRIP_DOMAIN=off
#LDAP_NESTED=off
#LDAP_STARTTLS=off
#LDAP_CACHE_TTL=5m
#LDAP_TIMEOUT=5s
# Duration or "off"
#LDAP_STALE_TTL=1h
